# Copy to services/api/.env (or export) for local development. Never commit real values.
DATABASE_URL=postgres://bho:bho@127.0.0.1:5432/ben_health_os
AUTH_MODE=local
LOCAL_JWT_SECRET=change-me-to-a-long-random-string
ALLOW_DEMO_SEED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:8787
# Phase 2 connectors (leave unset to show BLOCKED BY CREDENTIALS in Data Sources):
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# OURA_WEBHOOK_VERIFICATION_TOKEN=<random string>
# WITHINGS_CLIENT_ID=
# WITHINGS_CLIENT_SECRET=
# JOB_SECRET=<random string for /internal/jobs/reconcile>
# WEB_BASE_URL=http://localhost:3000
# Hosted (AUTH_MODE=supabase):
# SUPABASE_URL=https://<project>.supabase.co
# TOKEN_ENCRYPTION_KEY=<base64 of 32 random bytes>
