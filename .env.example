# Ben Health OS — environment variable NAMES only. Never commit values.
# Copy to .env (git-ignored) and fill in locally / in your deployment secret store.

# --- Database ---
# Postgres connection string for the platform service (least-privilege app role).
DATABASE_URL=
# Postgres connection string with owner rights, used only by the migration runner.
DATABASE_ADMIN_URL=

# --- Auth (local mode) ---
# 32+ byte secret for signing platform-issued JWTs (local auth mode).
AUTH_JWT_SECRET=
# Initial single-user login (created on first boot in local auth mode).
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=

# --- Token encryption ---
# base64-encoded 32-byte key for AES-256-GCM encryption of OAuth tokens at rest.
TOKEN_ENC_KEY=

# --- Withings ---
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Public HTTPS URL Withings redirects back to, e.g. https://api.example.com/api/v1/integrations/withings/callback
WITHINGS_REDIRECT_URI=
# Public HTTPS URL Withings notifies, e.g. https://api.example.com/api/v1/webhooks/withings
WITHINGS_WEBHOOK_URL=

# --- Oura (Phase 3) ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=

# --- Platform ---
PLATFORM_PORT=8787
# 'demo' enables the synthetic persona and the fake Withings server; 'production' requires real credentials.
PLATFORM_MODE=demo
# Comma-separated allowed origins for the web dashboard.
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_PLATFORM_URL=http://localhost:8787
